# ─────────────────────────────────────────────────────────────────────────────
# L/S SMID Portfolio — API Keys Template
# Copy this file to .env and fill in your own keys.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── EQUITY & FUNDAMENTALS ─────────────────────────────────────────────────────

# Financial Modeling Prep (fundamentals, financials, ratios, profiles)
# https://financialmodelingprep.com/developer/docs
OPENBB_FMP_API_KEY=your_fmp_key_here

# Intrinio (earnings revisions, short interest, institutional data)
# https://intrinio.com/
OPENBB_INTRINIO_API_KEY=your_intrinio_key_here

# Benzinga (news, earnings calendars, analyst ratings)
# https://www.benzinga.com/apis/
OPENBB_BENZINGA_API_KEY=your_benzinga_key_here

# ── PRICES & MARKET DATA ──────────────────────────────────────────────────────

# Nasdaq Data Link (equities, alternatives, economic datasets)
# https://data.nasdaq.com/sign-up
OPENBB_NASDAQ_API_KEY=your_nasdaq_key_here

# Polygon.io (OHLCV, corporate actions, trades)
# https://polygon.io/dashboard/signup
OPENBB_POLYGON_API_KEY=your_polygon_key_here

# Alpha Vantage (backup price source, forex, technicals)
# https://www.alphavantage.co/support/#api-key
OPENBB_ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# ── CRYPTO ────────────────────────────────────────────────────────────────────

# CoinGecko (crypto prices, market cap, on-chain data)
# https://www.coingecko.com/en/api
OPENBB_COINGECKO_API_KEY=your_coingecko_key_here

# CoinDesk (crypto news, Bitcoin price index)
# https://developers.coindesk.com/
OPENBB_COINDESK_API_KEY=your_coindesk_key_here

# TAO / Bittensor (decentralised AI network data)
OPENBB_TAO_API_KEY=your_tao_key_here

# ── MACRO & GOVERNMENT DATA ───────────────────────────────────────────────────

# FRED — Federal Reserve Economic Data (completely free)
# https://fred.stlouisfed.org/docs/api/api_key.html
OPENBB_FRED_API_KEY=your_fred_key_here

# BLS — Bureau of Labor Statistics (employment, CPI, PPI)
# https://www.bls.gov/developers/
OPENBB_BLS_API_KEY=your_bls_key_here

# EIA — Energy Information Administration (oil, gas, power data)
# https://www.eia.gov/opendata/register.php
OPENBB_EIA_API_KEY=your_eia_key_here

# EconDB (global macro, country-level indicators)
# https://www.econdb.com/api/
OPENBB_ECONDB_API_KEY=your_econdb_key_here

# ── REGULATORY & GOVERNMENT ───────────────────────────────────────────────────

# CFTC — Commitments of Traders, derivatives positioning
# https://publicreporting.cftc.gov/ (may not require key)
OPENBB_CFTC_API_KEY=your_cftc_key_here

# Congress.gov — legislative data, congressional trading
# https://api.congress.gov/sign-up/
OPENBB_CONGRESS_API_KEY=your_congress_key_here
