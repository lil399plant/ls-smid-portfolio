# ─────────────────────────────────────────────────────────────────────────────
# L/S SMID Portfolio — API Keys Template
# Copy this file to .env and fill in your own keys.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Financial Modeling Prep (fundamentals, financials, ratios)
# Free tier: https://financialmodelingprep.com/developer/docs
OPENBB_FMP_API_KEY=your_fmp_key_here

# Polygon.io (prices, OHLCV, corporate actions)
# Free tier: https://polygon.io/dashboard/signup
OPENBB_POLYGON_API_KEY=your_polygon_key_here

# FRED (macro data — completely free)
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
OPENBB_FRED_API_KEY=your_fred_key_here

# Intrinio (optional — earnings revisions, short interest)
# https://intrinio.com/
OPENBB_INTRINIO_API_KEY=your_intrinio_key_here

# Alpha Vantage (optional — backup price source)
# Free tier: https://www.alphavantage.co/support/#api-key
OPENBB_ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
